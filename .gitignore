# Test design corpus lives in-repo but stays untracked (101MB of design JSON,
# images and reference renders; open-source users bring or fetch their own)
/FigmaExports/

# Font binaries stay local: 82 tracked ttf/otf files carried permissive-license
# gaps (11 OFL families without license text, 6 Chinese display fonts with
# unverified redistribution terms) and 40MB+ of history weight. The runtime
# font lookup falls back to Saved/ManualFonts, engine and system font
# directories when the plugin Fonts/ folder is absent.
/Fonts/

# Pen design corpus stays local: open-source users import the .pen samples
# under Examples/ or bring their own designs; this path is a local workspace
# slot (optionally a directory junction to the editing source on this machine)
/PenDesigns/
