# Normalize Windows-facing text files in the repository.
* text=auto
*.h text eol=crlf
*.hpp text eol=crlf
*.cpp text eol=crlf
*.cs text eol=crlf
*.py text eol=crlf
*.md text eol=crlf
*.json text eol=crlf
*.yml text eol=crlf
*.yaml text eol=crlf

# Exclude maintainer-only workflow files from generated source archives.
AGENTS.md export-ignore
CLAUDE.md export-ignore
/*REVIEW*.md export-ignore
/*Review*.md export-ignore
/*review*.md export-ignore
/CODE_REVIEW*.md export-ignore
/code_review*.md export-ignore
/design2umg_code_review*.md export-ignore

# Exclude local workflow directories from generated source archives.
.cowork-temp/ export-ignore
.claude/ export-ignore
.codex/ export-ignore
openspec/ export-ignore
openspec/** export-ignore

# Private validation data and the maintainer progress ledger are not source-release assets.
/PenDesigns/ export-ignore
/FigmaExports/ export-ignore
/CODE_QUALITY_OPTIMIZATION_PLAN.md export-ignore
