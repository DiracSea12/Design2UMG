{
  "version": "1.0",
  "children": [
    {
      "id": "card",
      "type": "frame",
      "name": "DashboardCard",
      "width": 320,
      "height": 180,
      "layout": "vertical",
      "padding": [24, 24, 24, 24],
      "gap": 12,
      "fill": "#FFFFFF",
      "cornerRadius": 12,
      "effects": [{ "type": "shadow", "offsetX": 0, "offsetY": 2, "blur": 8, "color": "#0000001A" }],
      "children": [
        {
          "id": "header",
          "type": "frame",
          "name": "Header",
          "width": "fill_container",
          "layout": "horizontal",
          "justifyContent": "space_between",
          "alignItems": "center",
          "children": [
            {
              "id": "label",
              "type": "text",
              "name": "Label",
              "content": "Total Revenue",
              "fontSize": 14,
              "fill": "#6C757D"
            },
            {
              "id": "badge",
              "type": "frame",
              "name": "Badge",
              "layout": "horizontal",
              "padding": [8, 4, 8, 4],
              "fill": "#D4EDDA",
              "cornerRadius": 12,
              "children": [
                {
                  "id": "badge-text",
                  "type": "text",
                  "name": "BadgeText",
                  "content": "+12.5%",
                  "fontSize": 12,
                  "fontWeight": "600",
                  "fill": "#155724"
                }
              ]
            }
          ]
        },
        {
          "id": "value",
          "type": "text",
          "name": "Value",
          "content": "$48,290",
          "fontSize": 32,
          "fontWeight": "bold",
          "fill": "#1A1A2E"
        },
        {
          "id": "chart-area",
          "type": "rectangle",
          "name": "ChartPlaceholder",
          "width": "fill_container",
          "height": "fill_container",
          "fill": "#F0F4FF",
          "cornerRadius": 6
        }
      ]
    }
  ]
}
