{
  "version": "1.0",
  "children": [
    {
      "id": "login-frame",
      "type": "frame",
      "name": "LoginForm",
      "width": 400,
      "height": 480,
      "layout": "vertical",
      "padding": [32, 32, 32, 32],
      "gap": 16,
      "fill": "#FFFFFF",
      "cornerRadius": 12,
      "justifyContent": "center",
      "alignItems": "center",
      "children": [
        {
          "id": "title",
          "type": "text",
          "name": "Title",
          "width": "fill_container",
          "content": "Welcome Back",
          "fontSize": 28,
          "fontWeight": "bold",
          "fill": "#1A1A2E",
          "textAlign": "center"
        },
        {
          "id": "subtitle",
          "type": "text",
          "name": "Subtitle",
          "width": "fill_container",
          "content": "Sign in to continue",
          "fontSize": 14,
          "fill": "#6C757D",
          "textAlign": "center"
        },
        {
          "id": "email-input",
          "type": "frame",
          "name": "EmailInput",
          "width": "fill_container",
          "height": 48,
          "layout": "horizontal",
          "padding": [12, 0, 12, 0],
          "fill": "#F8F9FA",
          "cornerRadius": 8,
          "alignItems": "center",
          "stroke": { "thickness": 1, "fill": "#DEE2E6" },
          "children": [
            {
              "id": "email-text",
              "type": "text",
              "name": "EmailPlaceholder",
              "content": "Email address",
              "fontSize": 14,
              "fill": "#ADB5BD"
            }
          ]
        },
        {
          "id": "password-input",
          "type": "frame",
          "name": "PasswordInput",
          "width": "fill_container",
          "height": 48,
          "layout": "horizontal",
          "padding": [12, 0, 12, 0],
          "fill": "#F8F9FA",
          "cornerRadius": 8,
          "alignItems": "center",
          "stroke": { "thickness": 1, "fill": "#DEE2E6" },
          "children": [
            {
              "id": "password-text",
              "type": "text",
              "name": "PasswordPlaceholder",
              "content": "Password",
              "fontSize": 14,
              "fill": "#ADB5BD"
            }
          ]
        },
        {
          "id": "login-btn",
          "type": "frame",
          "name": "LoginButton",
          "width": "fill_container",
          "height": 48,
          "layout": "horizontal",
          "fill": "#4361EE",
          "cornerRadius": 8,
          "justifyContent": "center",
          "alignItems": "center",
          "children": [
            {
              "id": "btn-text",
              "type": "text",
              "name": "ButtonLabel",
              "content": "Sign In",
              "fontSize": 16,
              "fontWeight": "600",
              "fill": "#FFFFFF"
            }
          ]
        },
        {
          "id": "forgot",
          "type": "text",
          "name": "ForgotPassword",
          "content": "Forgot password?",
          "fontSize": 13,
          "fill": "#4361EE"
        }
      ]
    }
  ]
}
